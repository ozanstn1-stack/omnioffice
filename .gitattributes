# Keep the translation source LF: its encoding test parses the file as text and
# a CRLF checkout used to break the Turkish-character check on Windows runners.
src/lib/i18n.ts text eol=lf

# TypeScript bindings are written with LF by ts-rs (`npm run types:gen`); a CRLF
# checkout would make the drift check report a change that is not there.
src/lib/generated/*.ts text eol=lf

# Golden fixtures are byte contracts: a CRLF checkout on a Windows runner used
# to make the reproducibility test fail even though the model had not changed.
crates/officecore/tests/fixtures/*.oswk binary
# The legacy Excel fixture is a BIFF container; never let git rewrite its bytes.
crates/officecore/tests/fixtures/*.xls binary

# The Gradle shell wrapper must be LF: the committed copy was CRLF, which fails
# under `sh` on Linux. android.yml never noticed because `tauri android init`
# regenerates the wrapper there; desktop.yml's Kotlin job restores the
# committed files and then runs the wrapper directly.
src-tauri/gen/android/gradlew text eol=lf
