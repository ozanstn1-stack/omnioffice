{
  "name": "pdf-swiss-army-knife",
  "private": true,
  "version": "6.1.11",
  "type": "module",
  "description": "OmniOffice - local-first desktop office and PDF suite (Writer, Calc, Impress, PDF tools)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "build:info": "node scripts/build-info.mjs",
    "sbom:rust": "node scripts/sbom-rust.mjs",
    "release:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-local.ps1",
    "release:fetch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-release.ps1",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e:smoke": "node e2e/smoke.mjs",
    "e2e:smoke:pdf": "node e2e/smoke.mjs --pdf samples/sample-1.pdf",
    "e2e:flows": "node e2e/smoke.mjs --all",
    "e2e:personas": "node e2e/smoke.mjs --persona accountant,student,public",
    "test:watch": "vitest",
    "test:rust": "cargo test --workspace",
    "bench:check": "node scripts/check-bench-regression.mjs",
    "compat:score": "node scripts/compat-score.mjs",
    "docs:stats": "node scripts/docs-stats.mjs",
    "docs:stats:check": "node scripts/docs-stats.mjs --check",
    "files:check": "node scripts/check-file-sizes.mjs --check",
    "files:update": "node scripts/check-file-sizes.mjs --update",
    "test:all": "npm run test && npm run test:rust",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "format:gate": "node scripts/check-format.mjs frontend",
    "format:gate:rust": "node scripts/check-format.mjs rust",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "fmt:rust": "cargo fmt --all",
    "fmt:rust:check": "cargo fmt --all -- --check",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "claims:check": "node scripts/claims-audit.mjs",
    "types:gen": "node scripts/types-gen.mjs",
    "types:check": "node scripts/types-gen.mjs --check",
    "check": "npm run lint && npm run i18n:audit && npx tsc --noEmit && npm run test",
    "check:fast": "npm run lint && npm run i18n:audit && npx tsc --noEmit && npm run test",
    "check:all": "npm run check:fast && npm run format:check && npm run fmt:rust:check && npm run lint:rust && npm run test:rust && npm run build",
    "engines:fetch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-engines.ps1",
    "engines:verify-lock": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-engines.ps1 -VerifyLock",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "android:engines": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-engines-android.ps1",
    "android:engines:verify-lock": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-engines-android.ps1 -VerifyLock",
    "android:init": "tauri android init",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:build:all": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& ./scripts/build-android.ps1 -Abi arm64-v8a,armeabi-v7a\"",
    "android:dev": "tauri android dev",
    "e2e:persona:lawyer": "node e2e/smoke.mjs --persona lawyer"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "lucide-react": "^1.53.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tauri-plugin-android-fs-api": "^30.2.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "tinypool": "^2.1.2",
    "source-map-js": "^1.2.2",
    "zod": "^4.6.7"
  }
}
