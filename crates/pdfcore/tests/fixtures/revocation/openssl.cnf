# Throwaway test PKI for crates/pdfcore/tests/revocation.rs. Every key made
# with this configuration is a test key; nothing here is trusted anywhere.

[ ca ]
default_ca = test_ca

[ test_ca ]
dir              = .
database         = index.txt
new_certs_dir    = newcerts
serial           = serial
crlnumber        = crlnumber
default_md       = sha256
default_days     = 36500
default_crl_days = 36500
policy           = policy_any
unique_subject   = no
copy_extensions  = none

[ policy_any ]
commonName = supplied

[ req ]
distinguished_name = req_dn
prompt             = no

[ req_dn ]
CN = unused

[ v3_ca ]
basicConstraints     = critical, CA:true
keyUsage             = critical, keyCertSign, cRLSign
subjectKeyIdentifier = hash

[ v3_signer ]
basicConstraints       = CA:false
keyUsage               = critical, digitalSignature, nonRepudiation
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid
authorityInfoAccess    = OCSP;URI:http://ocsp.omnioffice.test/, caIssuers;URI:http://pki.omnioffice.test/ca.der
crlDistributionPoints  = URI:http://crl.omnioffice.test/ca.crl, URI:ldap://ldap.omnioffice.test/cn=ca

[ v3_responder ]
basicConstraints       = CA:false
keyUsage               = critical, digitalSignature
extendedKeyUsage       = OCSPSigning
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid

[ v3_rogue ]
basicConstraints = CA:false
keyUsage         = critical, digitalSignature
extendedKeyUsage = OCSPSigning
