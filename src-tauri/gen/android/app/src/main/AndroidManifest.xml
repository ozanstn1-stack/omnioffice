<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Background work: a dataSync foreground service keeps long jobs (OCR,
         compression, conversions) alive while the app is in the background.
         POST_NOTIFICATIONS only shows its notification on Android 13+; the
         service works without it and the prompt is asked for once. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- In-app update: the app downloads the release APK and opens the system
         package installer for it (ApkInstallerPlugin). The user still
         confirms every installation in the system UI. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Document scanner: the camera permission is requested at runtime, only
         when the user starts a scan. The feature is optional (required=false),
         so a device without a camera can still install the app. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.pdf_swiss_army_knife"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true"
            android:grantUriPermissions="true">
            <!-- Long-press launcher shortcuts: Scan, New document, Recent files. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!--
              File associations ("Open with" and share). HAND-MAINTAINED, not generated:
              tauri.android.conf.json clears bundle.fileAssociations, so tauri-build no longer
              rewrites this block. Its output (a bare <data android:pathPattern> per extension)
              never matched a real intent: a path is only evaluated when the filter also has a
              scheme and a host, and a filter without any type or scheme only matches intents
              that carry no data at all. How Android matches, and what each filter is for:
              - Typed filter: SEND / SEND_MULTIPLE carry no data URI, only a type (so no scheme
                here), and VIEW from a file manager arrives as content:// (or file://) + type.
                With no scheme declared, a type alone matches content: and file: URIs.
              - Fallback filters (VIEW): for senders that give a generic type (octet-stream) or
                none, match on the file name instead. A path needs a scheme AND a host, hence
                host="*" (it also matches the empty host of file:///). Do NOT put a specific
                mimeType into these: type and path must both match, and most content:// paths
                carry no extension.
              - Before API 31 a `.*` glob stops at the first dot, so ".*\.docx" misses
                "My.Report.docx"; one pattern per dot count covers up to three dots, and
                pathSuffix (API 31+) is exact. Globs are case-sensitive; typed intents cover
                upper-case names.
              Every extension here must stay in IncomingFiles.openableExtensions, otherwise the
              copy pipeline rejects the file after Android handed it over; ManifestIntentFiltersTest
              (JVM) and OpenWithIntentTest (device) pin all of this.
            -->
            <!-- Typed: open with / share, one entry per supported type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Word (docx) -->
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <!-- OpenDocument text (odt) -->
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <!-- Rich text (rtf) -->
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/rtf" />
                <!-- Excel (xlsx) -->
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <!-- OpenDocument spreadsheet (ods) -->
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <!-- PowerPoint (pptx) -->
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <!-- OpenDocument presentation (odp) -->
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
                <!-- PDF -->
                <data android:mimeType="application/pdf" />
                <!-- OmniOffice document (oswk, no registered type) -->
                <data android:mimeType="application/x-oswk" />
                <!-- Legacy Word/PowerPoint and macro-enabled/template OOXML.
                     The backend reads these (CFB importer or the OOXML reader). -->
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.ms-word.document.macroEnabled.12" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.template" />
                <data android:mimeType="application/vnd.ms-excel.sheet.macroEnabled.12" />
                <data android:mimeType="application/vnd.ms-powerpoint.presentation.macroEnabled.12" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <!-- Generic binary: Chrome's download provider and some mail apps
                     report application/octet-stream and hide the extension from the
                     URI path, so no path pattern can match them (a downloaded
                     report.docx arrives as .../document/msf%3A42). The copy pipeline
                     still checks the display name against openableExtensions, so a
                     non-document that lands here is rejected before anything opens. -->
                <data android:mimeType="application/octet-stream" />
