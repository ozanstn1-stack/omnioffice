{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Office Swiss Army Knife",
  "version": "3.0.0",
  "identifier": "io.github.ozanstn1.pdfswissarmyknife",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Office Swiss Army Knife",
        "label": "main",
        "width": 1360,
        "height": 860,
        "minWidth": 1060,
        "minHeight": 680,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "All your PDF tools in one place",
    "longDescription": "PDF Swiss Army Knife is a local-first desktop toolkit for merging, splitting, compressing, OCR-ing, watermarking, protecting and converting PDF documents. All processing happens on your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["docx"], "name": "Word document", "role": "Editor" },
      { "ext": ["odt"], "name": "OpenDocument text", "role": "Editor" },
      { "ext": ["rtf"], "name": "Rich text document", "role": "Editor" },
      { "ext": ["xlsx"], "name": "Excel workbook", "role": "Editor" },
      { "ext": ["ods"], "name": "OpenDocument spreadsheet", "role": "Editor" },
      { "ext": ["pptx"], "name": "PowerPoint presentation", "role": "Editor" },
      { "ext": ["odp"], "name": "OpenDocument presentation", "role": "Editor" },
      { "ext": ["pdf"], "name": "PDF document", "role": "Viewer" },
      { "ext": ["oswk"], "name": "Office Swiss Army Knife document", "role": "Editor" }
    ],
    "resources": [
      "resources/engines/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": false
      }
    }
  }
}
