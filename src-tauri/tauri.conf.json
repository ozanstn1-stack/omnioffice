{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniOffice",
  "version": "4.5.0",
  "identifier": "io.github.ozanstn1.pdfswissarmyknife",
  "mainBinaryName": "OmniOffice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OmniOffice",
        "label": "main",
        "width": 1360,
        "height": 860,
        "minWidth": 1060,
        "minHeight": 680,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Office suite and PDF toolkit that runs entirely on your machine",
    "longDescription": "OmniOffice is a local-first desktop suite: the Writer word processor, the Calc spreadsheet, the Impress presentation editor, a document vault and the complete PDF toolkit (merge, split, compress, OCR, watermark, protect, redact, sign, forms, PDF/A). Documents are never uploaded, there is no telemetry, and everything works offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["docx"], "name": "OmniOffice Word document", "role": "Editor" },
      { "ext": ["odt"], "name": "OmniOffice OpenDocument text", "role": "Editor" },
      { "ext": ["rtf"], "name": "OmniOffice Rich text document", "role": "Editor" },
      { "ext": ["xlsx"], "name": "OmniOffice Excel workbook", "role": "Editor" },
      { "ext": ["ods"], "name": "OmniOffice OpenDocument spreadsheet", "role": "Editor" },
      { "ext": ["pptx"], "name": "OmniOffice PowerPoint presentation", "role": "Editor" },
      { "ext": ["odp"], "name": "OmniOffice OpenDocument presentation", "role": "Editor" },
      { "ext": ["pdf"], "name": "OmniOffice PDF document", "role": "Viewer" },
      { "ext": ["oswk"], "name": "OmniOffice document", "role": "Editor" }
    ],
    "resources": [
      "resources/engines/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": false
      }
    }
  }
}
